<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>AI Chat App</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    body {
      font-family: "Segoe UI", sans-serif;
      background: #f0f2f5;
      /* height: 100vh;
      margin: 0;
      display: flex;
      justify-content: center;
      align-items: center; */
    }

    .app-wrapper {
      width: 90%;
      width: 100vw;
      height: 80vh;
      background: #fff;
      display: flex;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
    }

    /* ---------- SIDEBAR ---------- */
    .sidebar {
      background: #202123;
      color: #fff;
      width: 220px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 15px;
    }

    .sidebar h2 {
      font-size: 18px;
      margin: 0 0 15px;
      text-align: center;
    }

    .chat-list {
      flex: 1;
      overflow-y: auto;
    }

    .chat-list::-webkit-scrollbar {
      width: 6px;
    }

    .chat-list::-webkit-scrollbar-thumb {
      background-color: #555;
      border-radius: 3px;
    }

    .chat-item {
      background: #2a2b2f;
      border-radius: 10px;
      padding: 10px;
      margin-bottom: 10px;
      cursor: pointer;
      transition: background 0.2s;
    }

    .chat-item:hover {
      background: #34363a;
    }

    .new-chat-btn {
      background: #10a37f;
      color: white;
      border: none;
      padding: 10px;
      border-radius: 10px;
      cursor: pointer;
      font-weight: bold;
      transition: background 0.2s;
      width: 100%;
    }

    .new-chat-btn:hover {
      background: #0e8c6f;
    }

    /* ---------- CHAT AREA ---------- */
    .chat-container {
      flex: 1;
      display: flex;
      flex-direction: column;
      background: #f9f9f9;
    }

    .chat-box {
      flex: 1;
      padding: 15px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
    }

    .message {
      display: flex;
      align-items: flex-start;
      margin-bottom: 12px;
    }
    .errors-red{
      color: red;
    }

    .avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      font-weight: bold;
      display: flex;
      justify-content: center;
      align-items: center;
      color: white;
      margin-right: 10px;
      flex-shrink: 0;
    }

    .ai .avatar {
      background: #10a37f;
    }

    .user .avatar {
      background: #0078ff;
      order: 2;
      margin-left: 10px;
      margin-right: 0;
    }

    .bubble {
      background: #e5e5ea;
      padding: 10px 15px;
      border-radius: 18px;
      max-width: 70%;
      word-wrap: break-word;
      line-height: 1.4;
    }

    .ai .bubble {
      background: #f1f1f1;
      border-top-left-radius: 4px;
    }

    .user {
      justify-content: flex-end;
    }

    .user .bubble {
      background: #0078ff;
      color: white;
      border-top-right-radius: 4px;
    }
 
    .input-wrapper {
      border-top: 1px solid #ddd;
      padding: 10px 15px;
      background: #fafafa;
    }
    .input-area {
      display: flex;
      align-items: center;
      padding: 10px 15px;
      /* border-top: 1px solid #ddd; */
      background: #fafafa;
      position: relative;
      max-width: 900px;
    }

    .input-area input {
      flex: 1;
      padding: 12px 50px 12px 15px;
      border: 1px solid #ccc;
      border-radius: 25px;
      outline: none;
      font-size: 15px;
    }

    .input-area button {
      position: absolute;
      right: 25px;
      background: #10a37f;
      color: white;
      border: none;
      border-radius: 50%;
      width: 32px;
      height: 32px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      transition: background 0.2s;
    }

    .input-area button:hover {
      background: #0e8c6f;
    }
    #header {
      background-color: #10a37f;
      color: white;
      padding: 15px;
      text-align: center;
      font-size: 24px;
      font-weight: bold;
      border-radius: 10PX;
      margin-bottom: 10px;
    }

    
  </style>
</head>
<body>
  <div id="header"> AI SUMMIT STRATHMORE HACKATHON</div>
  <div class="app-wrapper">
    <!-- SIDEBAR -->
    <div class="sidebar">
      <div>
        <h2>My Chats</h2>
        <div class="chat-list" id="chatList">
          <div class="chat-item">Chat 1</div>
          <div class="chat-item">Chat 2</div>
        </div>

        <h3>Settings</h3>
            <div class="chat-list">
                <label for="themeSelect">Theme:</label>
                <select id="themeSelect">
                    <option value="light">Light</option>
                    <option value="dark">Dark</option>
                </select>

                <!-- <select id="themeSelect" style="margin-top: 10px; border-radius: 8px; padding: 6px;">
  <option value="light">Light</option>
  <option value="dark">Dark</option>
</select> -->

            </div>
      </div>
      <button class="new-chat-btn" id="newChatBtn">+ New Chat</button>
    </div>

    <!-- CHAT AREA -->
    <div class="chat-container">
      <div id="chatBox" class="chat-box"></div>

      <div class="input-wrapper">
      <div class="input-area">
        <input id="messageInput" placeholder="Message Here..." autocomplete="off" />
        <button id="sendBtn">➤</button>
      </div>
      </div>
    </div>
  </div>

  <script src="index.js"></script>
</body>
</html>
